{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationTimeline",
  "type": "object",
  "required": [
    "schema_version",
    "call_id",
    "created_utc",
    "audio_meta",
    "frame_rate_hz",
    "n_frames",
    "overlap_mask",
    "speakers",
    "corpus_stats",
    "turns",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "call_id": { "type": "string" },
    "created_utc": { "type": "string" },
    "audio_meta": {
      "type": "object",
      "required": ["path", "sha256", "original_sr", "channels", "duration_s", "branch"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "original_sr": { "type": "integer" },
        "channels": { "type": "integer" },
        "duration_s": { "type": "number" },
        "branch": { "type": "string", "enum": ["stereo_split", "mono_separated", "no_split"] }
      }
    },
    "frame_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
    "n_frames": { "type": "integer", "minimum": 0 },
    "overlap_mask": { "type": "string" },
    "speakers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["stream_path", "total_speech_s", "embedding_key"],
        "properties": {
          "stream_path": { "type": "string" },
          "total_speech_s": { "type": "number" },
          "embedding_key": { "type": "string" }
        }
      }
    },
    "corpus_stats": {
      "type": "object",
      "required": ["total_speech_s", "overlap_speech_s", "overlap_ratio", "n_turns", "n_interruptions"],
      "properties": {
        "total_speech_s": { "type": "number" },
        "overlap_speech_s": { "type": "number" },
        "overlap_ratio": { "type": "number" },
        "n_turns": { "type": "integer" },
        "n_interruptions": { "type": "integer" }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "turn_id",
          "speaker",
          "start",
          "end",
          "provenance",
          "overlap",
          "quality"
        ],
        "properties": {
          "turn_id": { "type": "string" },
          "speaker": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "provenance": { "type": "string", "enum": ["clean", "separated"] },
          "text": { "type": ["string", "null"] },
          "word_timings": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["w", "s", "e", "conf"],
              "properties": {
                "w": { "type": "string" },
                "s": { "type": "number" },
                "e": { "type": "number" },
                "conf": { "type": "number" }
              }
            }
          },
          "word_timings_source": {
            "type": ["string", "null"],
            "enum": ["forced_align", "asr_fallback", null]
          },
          "overlap": {
            "type": "object",
            "required": ["ratio", "clean_speech_s", "interrupts", "interrupted_by", "preceding_gap_s"],
            "properties": {
              "ratio": { "type": "number" },
              "clean_speech_s": { "type": "number" },
              "interrupts": { "type": ["string", "null"] },
              "interrupted_by": { "type": ["string", "null"] },
              "preceding_gap_s": { "type": ["number", "null"] }
            }
          },
          "quality": {
            "type": "object",
            "properties": {
              "sep_cosine": { "type": ["number", "null"] },
              "asr_avg_logprob": { "type": ["number", "null"] },
              "no_speech_prob": { "type": ["number", "null"] },
              "compression_ratio": { "type": ["number", "null"] }
            }
          },
          "acoustic": {
            "type": ["object", "null"],
            "required": ["valence", "arousal", "conf", "pooled_frames", "masked_frames"],
            "properties": {
              "valence": { "type": "number" },
              "arousal": { "type": "number" },
              "conf": { "type": "number" },
              "pooled_frames": { "type": "integer" },
              "masked_frames": { "type": "integer" },
              "emotion": { "type": ["string", "null"] },
              "emotion_scores": {
                "type": ["object", "null"],
                "additionalProperties": { "type": "number" }
              }
            }
          },
          "acoustic_abstain_reason": {
            "type": ["string", "null"],
            "enum": ["SHORT_TURN", "HIGH_OVERLAP", "LOW_SEP_QUALITY", null]
          },
          "semantic": { "type": ["object", "null"] },
          "fused": { "type": ["object", "null"] }
        }
      }
    },
    "outcome": { "type": ["object", "null"] },
    "diagnostics": {
      "type": "object",
      "required": [
        "rejected_sources",
        "alignment_failures",
        "acoustic_abstentions",
        "abstain_reasons",
        "model_revisions",
        "stage_durations_s"
      ],
      "properties": {
        "rejected_sources": { "type": "array" },
        "alignment_failures": { "type": "integer" },
        "acoustic_abstentions": { "type": "integer" },
        "abstain_reasons": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "model_revisions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "stage_durations_s": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
